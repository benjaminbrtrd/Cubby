{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubby",
  "mainBinaryName": "Cubby",
  "version": "2026.11.0-beta.2",
  "identifier": "io.github.benjaminbrtrd.cubby",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cubby",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#1e1b18"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https://textures.minecraft.net https://minotar.net",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Cubby/instances/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFOTYzQjI2NDcyODg0MkEKUldRcWhDaEhKanVXRGxjVGtSQ2hhR05rZ0laYUdOSER2TERYbkFYNU4xTlVvWVg1d2dkU05melMK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cubby"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
